{
  "name": "ijro-nazorati",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && tsc --noEmit --incremental false && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed:private": "node scripts/db.mjs seed-private",
    "db:admin": "node scripts/db.mjs admin",
    "format": "prettier --write 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.4",
    "baseline-browser-mapping": "2.11.0"
  },
  "type": "module",
  "displayName": "Ichki hisobotlarni boshqarish tizimi"
}
