# Copy to deploy/.env on the server. Never commit real values.
DOMAIN=ijro.example.uz
SITE_BASE_URL=https://ijro.example.uz
APP_TIMEZONE=Asia/Tashkent

# Long random values: openssl rand -hex 32
REMINDER_JOB_SECRET=
TELEGRAM_WEBHOOK_SECRET=
INFORMATION_INGEST_SECRET=

# Telegram bot from @BotFather (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: AI answers in the information search
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_DAILY_REQUEST_LIMIT=200

# Local development only: act as this employee without logging in.
# Ignored unless NODE_ENV=development.
# DEV_IMPERSONATE_EMAIL=admin@ijro.local
